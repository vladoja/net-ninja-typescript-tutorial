{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug TypeScript (compiled)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dist/index.js",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "Build TypeScript",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}